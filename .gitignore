# ============================================
# Секреты и чувствительные данные (НЕ коммитить в публичный репозиторий)
# ============================================

# Environment (ключи Supabase и др.)
.env
.env.*
!.env.example
assets/.env

# Файлы с командами запуска, содержащие --dart-define с API ключами
flutter run.txt
**/flutter*run*.txt

# Android подпись (пароли и keystore)
key.properties
**/*.keystore
**/*.jks

# iOS / macOS сертификаты и ключи
*.p12
*.mobileprovision
*.cer

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
